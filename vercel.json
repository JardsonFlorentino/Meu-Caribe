{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/passeios-lancha",
            "destination": "/passeios-lancha.html"
        },
        {
            "source": "/aventura-aquatica",
            "destination": "/aventura-aquatica.html"
        },
        {
            "source": "/sobre",
            "destination": "/sobre.html"
        },
        {
            "source": "/contato",
            "destination": "/contato.html"
        },
        {
            "source": "/tabua-mares",
            "destination": "/tabua-mares.html"
        }
    ],
    "redirects": [
        {
            "source": "/:path*.html",
            "destination": "/:path*",
            "permanent": true
        },
        {
            "source": "/index.html",
            "destination": "/",
            "permanent": true
        },
    ]
}
]
}