{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/passeio-de-lancha-maragogi",
            "destination": "/passeio-de-lancha-maragogi.html"
        },
        {
            "source": "/aventura-aquatica",
            "destination": "/aventura-aquatica.html"
        },
        {
            "source": "/sobre",
            "destination": "/sobre.html"
        },
        {
            "source": "/contato",
            "destination": "/contato.html"
        },
        {
            "source": "/tabua-mares-maragogi",
            "destination": "/tabua-mares-maragogi.html"
        }
    ],
    "redirects": [
        {
            "source": "/index.html",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/passeios-lancha",
            "destination": "/passeio-de-lancha-maragogi",
            "permanent": true
        },
        {
            "source": "/passeio-de-lancha",
            "destination": "/passeio-de-lancha-maragogi",
            "permanent": true
        },
        {
            "source": "/passeios-lancha.html",
            "destination": "/passeio-de-lancha-maragogi",
            "permanent": true
        },
        {
            "source": "/passeio-de-lancha.html",
            "destination": "/passeio-de-lancha-maragogi",
            "permanent": true
        },
        {
            "source": "/passeio-de-lancha-maragogi.html",
            "destination": "/passeio-de-lancha-maragogi",
            "permanent": true
        },
        {
            "source": "/tabua-mares",
            "destination": "/tabua-mares-maragogi",
            "permanent": true
        },
        {
            "source": "/tabua-mares.html",
            "destination": "/tabua-mares-maragogi",
            "permanent": true
        },
        {
            "source": "/tabua-mares-maragogi.html",
            "destination": "/tabua-mares-maragogi",
            "permanent": true
        },
        {
            "source": "/aventura-aquatica.html",
            "destination": "/aventura-aquatica",
            "permanent": true
        },
        {
            "source": "/sobre.html",
            "destination": "/sobre",
            "permanent": true
        },
        {
            "source": "/contato.html",
            "destination": "/contato",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self'"
                }
            ]
        },
        {
            "source": "/assets/img/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/assets/icons/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/favicon.png",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=2592000"
                }
            ]
        },
        {
            "source": "/assets/data/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/lang/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, stale-while-revalidate=604800"
                }
            ]
        },
        {
            "source": "/(style.css|script.js|i18n.js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/tabelas/(.*).(css|js)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=600, stale-while-revalidate=86400"
                }
            ]
        }
    ]
}